# Provider selection. Do not put credentials in this file.
# An ordered chain may be "llama-cpp,openrouter".
ATOM_LLM_PROVIDERS=llama-cpp
ATOM_LLM_MODEL_PATH=C:\Projects\atom-harness-models\Qwen3-4B-Instruct-2507-Q8_0\qwen3-4b-instruct-2507-q8_0.gguf
ATOM_LLM_MODEL_SHA256=ae916ede1c010a26955ee8ae2e908bf8815a3f135ec860439ab924701c69d5f1
ATOM_LLM_CHAT_TEMPLATE=qwen-chatml-manual-v1
ATOM_LLAMA_SERVER=llama-server
ATOM_LLM_GPU_LAYERS=auto
ATOM_LLM_LANE_PARALLEL_SLOTS=1
ATOM_LLM_LANE_MAX_QUEUE_DEPTH=8
ATOM_HARNESS_OPERATOR_PORT=0
ATOM_TOOL_WORKSPACE=C:\Projects

# Operator V6 is loopback-only and local-only. Its browser access token is
# created in memory for each launch and must never be added to this file.
# Tool planning is harmless until the trusted interface approves an exact,
# one-time manifest. Tool results remain untrusted and cannot grant permission.

# Operator V6 does not activate cloud routing. The cloud variables below apply
# only to older or specialized provider entrypoints and never imply consent.
# A cloud model has no implicit default. Select its provider-specific ID.
# ATOM_LLM_MODEL=<explicit OpenRouter model ID>
# Set OPENROUTER_API_KEY in the process environment or secret manager.
# Cloud data remains blocked until this process explicitly sets:
# ATOM_ALLOW_CLOUD_DATA=1

# Custom GGUF files also require ATOM_LLM_MODEL_SHA256 and an explicit
# ATOM_LLM_CHAT_TEMPLATE of qwen-chatml-manual-v1 or raw-prompt-v1.
