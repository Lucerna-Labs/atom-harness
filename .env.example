# Provider selection. Do not put credentials in this file.
ATOM_LLM_PROVIDER=openrouter
ATOM_LLM_MODEL=mistralai/mistral-small-3.2-24b-instruct
# Set OPENROUTER_API_KEY in the process environment or secret manager.

# Optional local llama.cpp fallback.
ATOM_LLM_MODEL_PATH=C:\path\to\language-model.gguf
ATOM_LLAMA_CLI=llama-cli
ATOM_LLM_GPU_LAYERS=auto
