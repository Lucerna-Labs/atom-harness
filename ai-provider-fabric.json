{
  "schema": 1,
  "project_kind": "ai-harness",
  "runtime_entrypoint": "atom_harness_experiment.py",
  "provider_fabric": {
    "enabled": true,
    "module_path": "atom_provider_fabric.py",
    "runtime_marker": "ATOM_PROVIDER_FABRIC_RUNTIME",
    "ordered_fallback": true,
    "strict_json_required": true,
    "model_integrity_required": true,
    "noninteractive_completion_backend_required": true,
    "prompt_transport_declared": true,
    "machine_grounding_required": true,
    "default_local_provider": true,
    "bounded_retry_backoff": true,
    "explicit_provider_locations": true,
    "cloud_requires_explicit_consent": true,
    "circuit_breakers": true,
    "bounded_concurrency": true,
    "cancellation": true,
    "provider_cancellation_capability_exposed": true,
    "all_providers_must_be_preemptible": false,
    "backpressure_vibrations": true,
    "resident_model_preload": true,
    "authenticated_loopback_transport": true,
    "external_proxy_disabled_for_loopback": true,
    "in_memory_transport_secret": true,
    "typed_resident_on_off_ramps": true,
    "bounded_resident_queue": true,
    "supervised_crash_recovery": true,
    "one_model_load_per_process_generation": true
  },
  "integration_test": "tests/test_atom_language_harness_v3_integration.py"
}
