{
  "schema": 1,
  "project_kind": "ai-harness",
  "runtime_entrypoint": "atom_harness_operator_server.py",
  "permissioned_hands": {
    "enabled": true,
    "experimental": true,
    "fabric_module": "atom_tool_fabric.py",
    "fabric_marker": "ATOM_PERMISSIONED_HANDS_RUNTIME",
    "protocol_module": "atom_tool_protocol.py",
    "planner_marker": "ATOM_TOOL_PLANNER_RUNTIME",
    "capability_module": "atom_tool_capabilities.py",
    "capability_marker": "ATOM_TOOL_CAPABILITY_RUNTIME",
    "side_view_module": "atom_tool_side_view.py",
    "side_view_marker": "ATOM_TOOL_SIDE_VIEW_RUNTIME",
    "artifact_binding_marker": "render_atom_tool_artifact",
    "operator_permission_required_for_every_execution": true,
    "exact_manifest_hash_required": true,
    "model_candidate_reduced_to_capability_contract": true,
    "candidate_normalizations_user_visible": true,
    "missing_required_arguments_fail_closed": true,
    "one_time_non_replayable_grant": true,
    "changed_manifest_requires_new_permission": true,
    "permission_grant_secret_in_memory_only": true,
    "tool_results_are_untrusted": true,
    "tool_results_cannot_authorize_actions": true,
    "atom_memory_mutation_allowed": false,
    "shell_expansion": false,
    "provider_environment_secrets_forwarded": false,
    "process_executable_sha256_bound_into_manifest": true,
    "process_output_retention_bounded": true,
    "process_timeout_terminates_process_tree": true,
    "public_web_address_set_bound_into_manifest": true,
    "web_connect_uses_only_permission_bound_address": true,
    "web_redirects_allowed": false,
    "atomic_tool_artifacts": true,
    "user_visible_permission_surface": true,
    "user_visible_real_result_side_view": true
  },
  "integration_test": "tests/test_atom_universal_knowledge_integration.py"
}
