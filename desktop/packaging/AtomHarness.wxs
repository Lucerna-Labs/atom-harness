<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="Atom Harness"
    Language="1033"
    Version="$(var.ProductVersion)"
    Manufacturer="Lucerna Labs"
    UpgradeCode="{66D523BE-C7C9-4E9A-A578-8643502214F1}">
    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perUser"
      Description="Atom Harness Desktop"
      Manufacturer="Lucerna Labs" />
    <MajorUpgrade
      AllowSameVersionUpgrades="no"
      DowngradeErrorMessage="A newer version of Atom Harness is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="LucernaLabsFolder" Name="Lucerna Labs">
            <Directory Id="INSTALLFOLDER" Name="Atom Harness" />
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ProgramMenuDir" Name="Lucerna Labs" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component
        Id="ApplicationShortcuts"
        Guid="{B45BD30F-A6C3-49DF-B82A-8F0B54F24AE7}">
        <Shortcut
          Id="StartMenuShortcut"
          Directory="ProgramMenuDir"
          Name="Atom Harness"
          Description="Atom Harness Desktop"
          Target="[INSTALLFOLDER]AtomHarness.Desktop.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <Shortcut
          Id="DesktopShortcut"
          Directory="DesktopFolder"
          Name="Atom Harness"
          Description="Atom Harness Desktop"
          Target="[INSTALLFOLDER]AtomHarness.Desktop.exe"
          WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder
          Id="RemoveProgramMenuDir"
          Directory="ProgramMenuDir"
          On="uninstall" />
        <RemoveFolder
          Id="RemoveInstallFolder"
          Directory="INSTALLFOLDER"
          On="uninstall" />
        <RemoveFolder
          Id="RemoveLucernaLabsFolder"
          Directory="LucernaLabsFolder"
          On="uninstall" />
        <RemoveFolder
          Id="RemoveProgramsFolder"
          Directory="ProgramsFolder"
          On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\Lucerna Labs\Atom Harness"
          Name="installed"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="Atom Harness" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="ApplicationShortcuts" />
    </Feature>
  </Product>
</Wix>
